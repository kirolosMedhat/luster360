# ==============================================================================
# LUSTER 360 PLATFORM — MASTER ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to:
# - backend/.env for the Luster Media API
# - web/apps/events-gallery/.env.local for the public customer gallery
# - web/apps/command-center/.env.local for the operations command center

# ------------------------------------------------------------------------------
# 1. CORE BACKEND API (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (backend/.env & command-center/.env.local)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. MEDIA STORAGE PROVIDER (backend/.env)
# ------------------------------------------------------------------------------
# Set to 'GOOGLE_DRIVE' for production, or 'MOCK' for in-memory development
STORAGE_PROVIDER=GOOGLE_DRIVE

# Google Drive Root / Shared Drive Folder where event folders will be created
GOOGLE_DRIVE_PARENT_FOLDER_ID=1g9P-ABC123xyz-YourSharedFolderIdHere

# Option A: Service Account (Recommended for automated server background uploads)
# Paste the single-line JSON string or path to service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=luster-bot@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: OAuth2 User / Desktop Client (Optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 4. CUSTOMER EVENTS GALLERY (web/apps/events-gallery/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GALLERY_DOMAIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. OPERATIONS COMMAND CENTER (web/apps/command-center/.env.local)
# ------------------------------------------------------------------------------
# Uses NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
